{
  "name": "@forge/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup --config tsup.config.ts",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. apps/worker"
  },
  "dependencies": {
    "@forge/config": "workspace:*",
    "@forge/jobs": "workspace:*",
    "@forge/object-store": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "4.23.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
